---
interface Props {
  sub: string;
  /** Fallback when URL path has no /xx/ prefix. Defaults to 'en'. */
  defaultLang?: 'en' | 'ko' | 'ja';
  /** Set true on sites with their own routing logic (map/sim/portfolio).
   *  When true, the lang/theme/hamburger handlers are NOT auto-attached
   *  and the consuming site must wire them itself. */
  skipWiring?: boolean;
}

const { sub, defaultLang = 'en', skipWiring = false } = Astro.props;
---

<header data-default-lang={defaultLang}>
  <div class="nav-top">
    <a href="https://txid.uk" class="logo" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="logo-icon" aria-hidden="true">
        <circle cx="20" cy="20" r="19" fill="#f7931a"/>
        <rect x="18.5" y="1" width="3" height="38" fill="#0d1117"/>
        <rect x="10" y="18.5" width="29" height="3" fill="#0d1117"/>
        <rect x="1" y="18.5" width="6" height="3" fill="#0d1117"/>
      </svg>txid.uk
    </a>
    <span class="logo-sep">/</span>
    <span class="logo-sub">{sub}</span>
    <div class="nav-right">
      <div id="txid-auth-mount" class="auth-mount"></div>
      <div class="lang-dropdown desktop-only">
        <button class="lang-btn" id="lang-btn" title="Language" aria-label="Language" aria-expanded="false">EN</button>
        <div class="lang-menu" id="lang-menu" role="menu" aria-label="Language">
          <button>English</button>
          <button>한국어</button>
          <button>日本語</button>
        </div>
      </div>
      <button class="theme-btn desktop-only" id="theme-btn" title="테마 전환" aria-label="테마 전환"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path></svg></button>
      <div class="hamburger-wrap mobile-only">
        <button class="theme-btn" id="hamburger-btn" aria-label="메뉴" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="hamburger-panel" id="hamburger-panel">
          <div class="settings-section">
            <div class="settings-label" data-ko="언어" data-en="Language" data-ja="言語">Language</div>
            <div class="settings-lang-row">
              <button class="settings-lang-btn" data-lang="en">EN</button>
              <button class="settings-lang-btn" data-lang="ko">KO</button>
              <button class="settings-lang-btn" data-lang="ja">JA</button>
            </div>
          </div>
          <div class="settings-section settings-section--border">
            <button class="settings-item" id="hamburger-theme-btn">
              <span id="hamburger-theme-icon"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path></svg></span>
              <span id="hamburger-theme-label" data-ko="테마 전환" data-en="Toggle Theme" data-ja="テーマ切替">Toggle Theme</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* === Pill Capsule chrome — synced via @txid/ui sync.sh ===
     is:global because scoped style caused per-page unique
     data-astro-cid attributes that ballooned the CSP script-hash
     count (17→32 on id, pushing _headers toward the 2KB silent-drop
     threshold). Consumer sites already had their global.css header
     selectors cleaned in the PR #2 sync, so there is no specificity
     conflict to worry about. */
  header[data-default-lang] {
    font-family: var(--font-sans-ko, 'Pretendard Variable', Pretendard, Inter, system-ui, sans-serif);
  }

  .nav-top {
    display: flex;
    align-items: center;
    gap: var(--header-gap, 0.5rem);
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--footer-border, #21262d);
  }

  .logo {
    color: var(--color-bitcoin, #f7931a);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .logo-icon { flex-shrink: 0; }
  .logo-sep { color: var(--footer-border, #30363d); }
  .logo-sub { color: var(--footer-fg, #8b949e); font-size: 0.9rem; }

  .nav-right {
    display: inline-flex;
    align-items: center;
    gap: var(--header-gap, 0.5rem);
    margin-left: auto;
  }

  .lang-dropdown { position: relative; }

  .lang-btn,
  .theme-btn {
    background: var(--header-btn-bg, rgba(139, 148, 158, 0.12));
    border: none;
    color: var(--header-btn-fg, #c9d1d9);
    border-radius: var(--header-btn-radius, 999px);
    cursor: pointer;
    font-family: inherit;
    font-size: var(--header-font-size, 0.78rem);
    line-height: 1;
    transition: background 0.15s, color 0.15s;
  }
  .lang-btn { padding: var(--header-btn-pad-text, 0.4rem 0.95rem); }
  .theme-btn {
    padding: var(--header-btn-pad-icon, 0.4rem 0.55rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .lang-btn:hover,
  .theme-btn:hover { background: var(--header-btn-bg-hover, rgba(139, 148, 158, 0.18)); }

  .lang-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    background: var(--card-bg, #161b22);
    border: 1px solid var(--card-border, #21262d);
    border-radius: 8px;
    padding: 0.25rem;
    display: none;
    flex-direction: column;
    min-width: 110px;
    z-index: 50;
  }
  .lang-menu.open { display: flex; }
  .lang-menu button {
    background: transparent;
    border: none;
    color: var(--header-btn-fg, #c9d1d9);
    padding: 0.45rem 0.75rem;
    text-align: left;
    border-radius: 6px;
    cursor: pointer;
    font-size: var(--header-font-size, 0.78rem);
    font-family: inherit;
  }
  .lang-menu button:hover { background: var(--header-btn-bg-hover, rgba(139, 148, 158, 0.18)); }

  .hamburger-wrap { position: relative; }
  .desktop-only { display: inline-flex; }
  .mobile-only { display: none; }

  @media (max-width: 640px) {
    .desktop-only { display: none; }
    .mobile-only { display: inline-flex; }
  }

  .hamburger-panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    background: var(--card-bg, #161b22);
    border: 1px solid var(--card-border, #21262d);
    border-radius: 10px;
    padding: 0.75rem;
    display: none;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 180px;
    z-index: 50;
  }
  .hamburger-panel.open { display: flex; }

  .settings-section { display: flex; flex-direction: column; gap: 0.4rem; }
  .settings-section--border {
    border-top: 1px solid var(--card-border, #21262d);
    padding-top: 0.6rem;
  }
  .settings-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--footer-fg, #8b949e);
  }
  .settings-lang-row { display: inline-flex; gap: 0.35rem; }
  .settings-lang-btn {
    background: var(--header-btn-bg, rgba(139, 148, 158, 0.12));
    border: none;
    color: var(--header-btn-fg, #c9d1d9);
    border-radius: var(--header-btn-radius, 999px);
    padding: var(--header-btn-pad-text, 0.4rem 0.95rem);
    cursor: pointer;
    font-family: inherit;
    font-size: var(--header-font-size, 0.78rem);
  }
  .settings-lang-btn:hover { background: var(--header-btn-bg-hover, rgba(139, 148, 158, 0.18)); }
  .settings-lang-btn.active {
    background: var(--header-active-bg, #f7931a);
    color: var(--header-active-fg, #0d1117);
  }

  .settings-item {
    background: transparent;
    border: none;
    color: var(--header-btn-fg, #c9d1d9);
    padding: 0.45rem 0.4rem;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: inherit;
    font-size: var(--header-font-size, 0.78rem);
  }
  .settings-item:hover { background: var(--header-btn-bg-hover, rgba(139, 148, 158, 0.18)); }

  /* === Login mount slot (txid-auth-mount injects a button at runtime) === */
  .auth-mount button,
  .auth-mount a {
    background: var(--header-login-bg, rgba(247, 147, 26, 0.18));
    border: 1px solid var(--header-login-border, rgba(247, 147, 26, 0.4));
    color: var(--header-login-fg, #f7931a);
    border-radius: var(--header-btn-radius, 999px);
    padding: var(--header-btn-pad-text, 0.4rem 0.95rem);
    font-size: var(--header-font-size, 0.78rem);
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: background 0.15s;
  }
  .auth-mount button:hover,
  .auth-mount a:hover { background: rgba(247, 147, 26, 0.28); }
</style>

{!skipWiring && (
  <script>
    // Auto-wires #lang-btn dropdown, .settings-lang-btn hamburger buttons,
    // #hamburger-btn drawer toggle, #theme-btn / #hamburger-theme-btn.
    // defaultLang prop is read from <header data-default-lang>.
    // Sites with custom routing (map/sim/portfolio) pass skipWiring={true}.
    (function () {
      const headerEl = document.querySelector<HTMLElement>('header[data-default-lang]');
      const defaultLang = (headerEl?.dataset.defaultLang || 'en') as 'en' | 'ko' | 'ja';
      const supported = ['en', 'ko', 'ja'] as const;
      type Lang = typeof supported[number];

      const path = window.location.pathname;
      const m = path.match(/^\/([a-z]{2})(?:\/|$)/);
      const currentLang: Lang = (m && (supported as readonly string[]).includes(m[1]))
        ? (m[1] as Lang)
        : defaultLang;

      function setLang(target: string | undefined) {
        if (!target || !(supported as readonly string[]).includes(target) || target === currentLang) return;
        try { localStorage.setItem('lang', target); } catch { /* ignore */ }
        // Path-preserving: /ko/account/ → /en/account/ (more natural than always-root).
        // Sites whose target lang doesn't have the same path can 404; for those, opt out
        // via skipWiring={true} and handle routing themselves.
        const newPath = window.location.pathname.replace(/^\/(en|ko|ja)(\/|$)/, '/' + target + '$2');
        window.location.href = newPath !== window.location.pathname ? newPath : '/' + target + '/';
      }

      const langBtn = document.getElementById('lang-btn');
      const langMenu = document.getElementById('lang-menu');
      if (langBtn && langMenu) {
        langBtn.textContent = currentLang.toUpperCase();
        langBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = langMenu.classList.toggle('open');
          langBtn.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', (e) => {
          const target = e.target as Node;
          if (!langMenu.contains(target) && target !== langBtn) {
            langMenu.classList.remove('open');
            langBtn.setAttribute('aria-expanded', 'false');
          }
        });
        const order: Lang[] = ['en', 'ko', 'ja'];
        langMenu.querySelectorAll<HTMLButtonElement>('button').forEach((b, i) => {
          b.addEventListener('click', () => setLang(order[i]));
        });
      }

      document.querySelectorAll<HTMLButtonElement>('#hamburger-panel .settings-lang-btn').forEach((btn) => {
        if (btn.dataset.lang === currentLang) btn.classList.add('active');
        btn.addEventListener('click', () => setLang(btn.dataset.lang));
      });

      const hamBtn = document.getElementById('hamburger-btn');
      const hamPanel = document.getElementById('hamburger-panel');
      if (hamBtn && hamPanel) {
        hamBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = hamPanel.classList.toggle('open');
          hamBtn.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', (e) => {
          const target = e.target as Node;
          if (!hamPanel.contains(target) && target !== hamBtn) {
            hamPanel.classList.remove('open');
            hamBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      function setTheme(t: string) {
        document.documentElement.setAttribute('data-theme', t);
        try { localStorage.setItem('theme', t); } catch { /* ignore */ }
      }
      function toggleTheme() {
        const cur = document.documentElement.getAttribute('data-theme') || 'dark';
        setTheme(cur === 'dark' ? 'light' : 'dark');
      }
      document.getElementById('theme-btn')?.addEventListener('click', toggleTheme);
      document.getElementById('hamburger-theme-btn')?.addEventListener('click', toggleTheme);
    })();
  </script>
)}
