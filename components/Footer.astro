---
import { sites } from '../data/sites';

interface Props {
  lang?: 'en' | 'ko' | 'ja';
}

const pathLang = (Astro.url.pathname.split('/')[1] || '').toLowerCase();
const detected = pathLang === 'ko' || pathLang === 'ja' || pathLang === 'en' ? pathLang : undefined;
const lang: 'en' | 'ko' | 'ja' = Astro.props.lang ?? detected ?? 'en';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav class="footer-sites" aria-label="txid.uk sites">
      {sites.map((s) => (
        <a
          href={s.url}
          class="footer-site-link"
          target={s.host === 'sim.txid.uk' ? undefined : '_blank'}
          rel="noopener"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <Fragment set:html={s.icon} />
          </svg>
          <span>{s.name[lang]}</span>
        </a>
      ))}
    </nav>
    <div class="footer-bottom">
      <span class="footer-copy">&copy; {year} <a href="https://txid.uk">txid.uk</a></span>
      <span class="footer-links">
        <a href="https://x.com/bc1qwerty" target="_blank" rel="me noopener" aria-label="X">&#x1d54f;</a>
        <span class="footer-sep">·</span>
        <a href="https://bsky.app/profile/txid.uk" target="_blank" rel="me noopener" aria-label="Bluesky">Bluesky</a>
        <span class="footer-sep">·</span>
        <a href="https://njump.me/npub16qucsfagff58mkac3ynwqyy9rkhw6wgnjk6xre2eagfqxkudqngs4gfc2d" target="_blank" rel="me noopener" aria-label="Nostr">Nostr</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    font-family: var(--font-sans, 'Pretendard Variable', Pretendard, Inter, system-ui, -apple-system, 'Segoe UI', sans-serif);
    border-top: 1px solid var(--border, #21262d);
    margin-top: 40px;
    padding: 24px 16px 32px;
    color: var(--text2, #8b949e);
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-sites {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 10px;
  }

  .footer-site-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: .75rem;
    padding: 5px 10px;
    border: 1px solid var(--border, #21262d);
    border-radius: 6px;
    color: var(--text2, #8b949e);
    text-decoration: none;
    transition: color .2s, border-color .2s;
  }

  .footer-site-link:hover {
    color: var(--accent, #f7931a);
    border-color: rgba(247, 147, 26, 0.35);
  }

  .footer-site-link svg {
    opacity: .6;
    flex-shrink: 0;
  }

  .footer-site-link:hover svg {
    opacity: 1;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: .75rem;
  }

  .footer-copy a {
    color: inherit;
    text-decoration: none;
  }

  .footer-copy a:hover {
    color: var(--accent, #f7931a);
  }

  .footer-links {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .footer-links a {
    color: var(--text2, #8b949e);
    text-decoration: none;
    transition: color .2s;
  }

  .footer-links a:hover {
    color: var(--accent, #f7931a);
  }

  .footer-sep {
    opacity: .5;
  }
</style>
